# ---------- Database (Neon / Supabase PostgreSQL) ----------
# Use the pooled connection string. Include sslmode=require for hosted databases.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---------- Auth.js ----------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated company domains allowed to sign in (optional; leave empty to allow only
# ADMIN_EMAILS plus emails approved on Admin -> Employees, e.g. personal Gmail accounts)
ALLOWED_EMAIL_DOMAINS=""
# Lets an ADMIN_EMAILS address set or reset its password on /setup. Keep it private.
ADMIN_SETUP_CODE=""

# Comma-separated emails that are granted the admin role on login
ADMIN_EMAILS="hr@yourcompany.com"

# ---------- Office & attendance rules ----------
OFFICE_NAME="Head Office"
OFFICE_TIMEZONE="Asia/Karachi"
OFFICE_LAT="24.860966"
OFFICE_LNG="66.990501"
# Geofence radius in meters; check-ins outside are flagged as remote
OFFICE_RADIUS_METERS="200"
# Shift start (24h, office time) and grace period before an arrival counts as late
OFFICE_START_TIME="09:00"
LATE_GRACE_MINUTES="15"
# ISO weekdays that are working days (1 = Monday ... 7 = Sunday)
WORK_DAYS="1,2,3,4,5"

# ---------- Anti-spoofing thresholds ----------
# Reject readings with GPS accuracy worse than this (meters)
MAX_GPS_ACCURACY_METERS="3000"
# Flag when GPS position is this far (km) from the request's IP geolocation (Vercel headers)
IP_MISMATCH_KM="300"
